--- /dev/null
+++ b/render.yaml
@@ -0,0 +1,26 @@
+# Despliegue en Render como sitio estático (gratis).
+# El juego corre completo en el navegador con Pyodide, así que no hace falta
+# un servidor de Python: Render solo entrega los archivos.
+services:
+  - type: web
+    runtime: static
+    name: tetris-reto2
+    # Copia a public/ solo lo que necesita la versión web: la interfaz y los
+    # mismos archivos .py del juego. Así no se publican las pruebas, los .wav
+    # de demostración ni el código de la versión de terminal.
+    buildCommand: >-
+      rm -rf public && mkdir -p public &&
+      cp -r web motores juego audio public/ &&
+      rm -f public/juego/pruebas_juego.py public/audio/reproductor.py &&
+      find public -name "__pycache__" -prune -exec rm -rf {} +
+    staticPublishPath: ./public
+    routes:
+      # La raíz abre el juego directamente
+      - type: redirect
+        source: /
+        destination: /web/
+    headers:
+      # Pyodide y los .py casi no cambian: caché de una hora en el navegador
+      - path: /*
+        name: Cache-Control
+        value: public, max-age=3600
